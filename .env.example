# Supabase project settings (public, safe to share)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_URL="https://your-project-id.supabase.co"

# Vite-exposed versions of the above (used client-side)
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# KEEP SECRET — never commit to git
# Required on the server for admin operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Analytics (optional, privacy-friendly). Leave unset to keep analytics fully
# disabled — no script loads and no events fire. Set to your Plausible site
# domain to enable cookieless funnel tracking.
VITE_PLAUSIBLE_DOMAIN="abilitio.app"
# Optional: self-hosted Plausible script URL (defaults to plausible.io).
# VITE_PLAUSIBLE_SRC="https://plausible.io/js/script.js"
